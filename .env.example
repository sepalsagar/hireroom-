# HireRoom Environment Configuration
# Academic Project by Sepal Sagar (sepalsagar1234@gmail.com)
# All keys can be obtained from official free tiers without entering a credit card.

# -----------------------------------------------------------------------------
# 1. Google Gemini AI API (Server-side only)
# -----------------------------------------------------------------------------
# Required for interviewer co-pilot and resume parsing.
# Obtained free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-3.8-flash"

# -----------------------------------------------------------------------------
# 2. Database & Storage: Supabase PostgreSQL (pgvector)
# -----------------------------------------------------------------------------
# Create a free project at: https://supabase.com
# Connection string found in Project Settings > Database > Connection String (URI / Node)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Supabase Client API Keys (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# -----------------------------------------------------------------------------
# 3. User Authentication: Clerk
# -----------------------------------------------------------------------------
# Create a free application at: https://dashboard.clerk.com
# Enable Google and GitHub under User & Authentication > Social Connections
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Explicit Demo Mode for isolated development/preview environments (e.g., AI Studio iframe).
# STRICTLY IGNORED in production (when NODE_ENV=production). Defaults to false.
NEXT_PUBLIC_DEMO_MODE="false"

# -----------------------------------------------------------------------------
# 4. Merchant of Record / Billing: Dodo Payments (Sandbox)
# -----------------------------------------------------------------------------
# Create a free sandbox account at: https://test.dodopayments.com
# API Key from Developer Settings > API Keys
DODO_PAYMENTS_API_KEY="test_api_key_..."
DODO_PAYMENTS_WEBHOOK_KEY="whsec_..."
DODO_PAYMENTS_TEST_MODE="true"
BILLING_PROVIDER="dodo"
SUPER_ADMIN_EMAIL=
DODO_PAYMENTS_WEBHOOK_KEY=
PLAN_PRODUCT_IDS={"prod_xxx":"pro"}

# Alternate: Polar (https://polar.sh)
POLAR_ACCESS_TOKEN=""

# -----------------------------------------------------------------------------
# 5. App Hosting URL
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
